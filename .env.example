# Copiar a .env y completar. El archivo .env no se versiona.
#   cp .env.example .env

# --- General -----------------------------------------------------------------
APP_ENV=local
TZ=America/Lima

# --- Base de datos: Supabase Cloud ------------------------------------------
# En el dashboard de Supabase: Connect → "Session pooler" (puerto 5432, IPv4).
# No usar la conexión directa (db.<ref>.supabase.co, solo IPv6) ni el pooler en
# modo transacción (puerto 6543, no soporta prepared statements).
#   Host:    aws-0-<region>.pooler.supabase.com
#   Usuario: postgres.<project-ref>
#   Base:    postgres
# La app vive en el esquema `app` (lo crea Alembic) y n8n en el esquema `n8n`.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=5
# Esquema físico de las tablas. Vacío = el de backend/config/tables.yaml (`app`).
DB_SCHEMA=

# --- Base de datos alternativa: Azure SQL (configurada, no se usa por ahora) -
# El backend no depende del motor: basta con cambiar DATABASE_URL (ver docs/adr/0004).
# 1. Construir la imagen con el driver:  DB_EXTRAS=azure  (o `uv sync --extra azure` fuera de Docker)
# 2. DATABASE_URL=mssql+pymssql://<usuario>:<password>@<servidor>.database.windows.net:1433/<base>
# 3. DB_SCHEMA=dbo   (o el esquema que se cree para la app)
# 4. uv run alembic upgrade head  (crea las tablas en Azure SQL)
# DB_EXTRAS=
# Sin red ni base: DATABASE_URL=sqlite:///./data/demo.db (solo para demos y pruebas).

# --- App de planificación (vendedores) ---------------------------------------
# Secreto para firmar las sesiones (JWT). Generar con `openssl rand -hex 32`. Obligatorio.
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=12
# La sesión va en una cookie HttpOnly. Vacío = solo por HTTPS, salvo con APP_ENV=local.
# Fuera de local la API no arranca sin AUTH_SECRET (32+ caracteres), INGEST_API_TOKEN ni HTTPS.
AUTH_COOKIE_SECURE=
# Bloqueo de la cuenta tras varios intentos fallidos de login.
# Frontend servido en otro dominio (p. ej. Vercel reenviando /api a este backend): sus orígenes,
# separados por coma; admiten comodín (https://avicola2-*.vercel.app). Vacío = mismo dominio.
TRUSTED_ORIGINS=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Contraseña de los usuarios de prueba que crea `cli init` (solo con APP_ENV=local).
PLANNING_DEMO_PASSWORD=demo1234
# Máximo de días por envío y semanas de historia para "Sugerir con historial".
# Días que se pueden registrar desde hoy.
PLANNING_MAX_DAYS=7
# Hora de corte por defecto (el supervisor la cambia en la app): cada día se edita hasta esa
# hora, PLANNING_CUTOFF_DAYS_BEFORE días antes (1 = el día anterior). Ver docs/assumptions.md.
PLANNING_CUTOFF_TIME=19:00
PLANNING_CUTOFF_DAYS_BEFORE=1
# Bloqueo por horario encendido (el supervisor lo apaga desde Habilitaciones o Usuarios).
PLANNING_CUTOFF_ENABLED=true
# Primer día que se registra: 1 = mañana (por defecto), 0 = también hoy.
PLANNING_STARTS_IN_DAYS=1
# Cada cuántos segundos se revisa si pasó un corte para avisar quién no registró (0 = lo hace n8n).
PLANNING_SCHEDULER_SECONDS=60
PLANNING_SUGGESTION_WEEKS=4

# n8n usa el mismo proyecto y pooler, en su propio esquema.
N8N_DB_HOST=aws-0-<region>.pooler.supabase.com
N8N_DB_PORT=5432
N8N_DB_DATABASE=postgres
N8N_DB_USER=postgres.<project-ref>
N8N_DB_PASSWORD=<password>
N8N_DB_POOL_SIZE=2
N8N_DB_SSL_ENABLED=true
# El certificado del pooler lo firma la CA de Supabase. Para validarlo, descargarla del
# dashboard, montarla en n8n y usar DB_POSTGRESDB_SSL_CA; mientras tanto, false.
N8N_DB_SSL_REJECT_UNAUTHORIZED=false

# --- Alternativa sin internet: perfil localdb --------------------------------
# docker compose --profile localdb up -d  y reemplazar lo de arriba por:
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres
#   DATABASE_URL_CONTAINER=postgresql+psycopg://postgres:postgres@postgres:5432/postgres
#   N8N_DB_HOST=postgres  N8N_DB_USER=postgres  N8N_DB_PASSWORD=postgres
#   N8N_DB_SSL_ENABLED=false  N8N_DB_SSL_REJECT_UNAUTHORIZED=true
#   (n8n activa SSL solo con que REJECT_UNAUTHORIZED sea false, y el Postgres local no tiene SSL)
# LOCALDB_PASSWORD=postgres
# LOCALDB_PORT=5432

# --- Lakehouse (Delta) -------------------------------------------------------
# Fuera de Docker: ruta relativa a la raíz del repo, o gs://<bucket>/lakehouse en GCP.
LAKEHOUSE_URI=./data/lakehouse
# Dentro del contenedor backend: /data/lakehouse (volumen local) o gs://<bucket>/lakehouse en GCP.
LAKEHOUSE_URI_CONTAINER=/data/lakehouse

# --- n8n ---------------------------------------------------------------------
# Generar una clave aleatoria larga (p. ej. `openssl rand -hex 32`) y no cambiarla después:
# cifra las credenciales guardadas en n8n.
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# En GCP detrás de HTTPS (Caddy) poner true.
N8N_SECURE_COOKIE=false

# --- Saca (conversión de kg de producto a pollo vivo) -----------------------
# Valores de referencia por validar con Avícola 2 (docs/assumptions.md).
YIELD_FACTOR=0.75
AVG_LIVE_WEIGHT_KG=2.6

# --- Backend -----------------------------------------------------------------
# Token que n8n envía en X-Api-Token a /ingest/* (provisional hasta el login con JWT).
# Generar con `openssl rand -hex 24`. Vacío = sin control (solo para desarrollo).
INGEST_API_TOKEN=
BACKEND_PORT=8000
UVICORN_WORKERS=1

# --- Logs ----------------------------------------------------------------------
# Se escriben en logs/ (raíz del repo; en Docker, montada en /data/logs):
#   app.log    todo desde LOG_LEVEL: peticiones (con id y duración), logins, envíos, cargas.
#   errors.log solo errores del backend, con la traza completa.
#   frontend.log errores que reporta la PWA desde el navegador (POST /api/client-logs).
# Rotan al llegar a LOG_MAX_MB.
# Cada respuesta lleva X-Request-ID; búscalo en los logs para ver toda esa petición.
LOG_LEVEL=INFO
# text (legible) o json (una línea por evento, para Cloud Logging).
LOG_FORMAT=text
# false = solo consola (docker compose logs backend).
LOG_TO_FILES=true
LOG_MAX_MB=10
LOG_BACKUPS=5
# Fuera de Docker, otra carpeta (por defecto ./logs):
# LOG_DIR=

# --- Límites de memoria por servicio (meta lite < ~2.5 GB) -------------------
N8N_MEM_LIMIT=768m
BACKEND_MEM_LIMIT=512m
