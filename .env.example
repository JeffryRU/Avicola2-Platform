# Credenciales de la base de datos (Azure SQL)
# Copia este archivo como .env y completa los valores.
# El .env nunca se sube a GitHub ni se comparte.

DB_SERVER=<servidor>.database.windows.net
DB_PORT=1433
DB_NAME=pruebas_app
DB_USER=dev_app_maker
DB_PASSWORD=
DB_SCHEMA=dbo
DB_ENCRYPT=true
DB_TRUST_CERT=false

# Puerto donde se abre la app (http://localhost:3000)
PORT=3000
