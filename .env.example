# Copiar a .env y completar. El archivo .env no se versiona.
#   cp .env.example .env

# --- General -----------------------------------------------------------------
APP_ENV=local
TZ=America/Lima

# --- Base de datos: Supabase Cloud ------------------------------------------
# En el dashboard de Supabase: Connect → "Session pooler" (puerto 5432, IPv4).
# No usar la conexión directa (db.<ref>.supabase.co, solo IPv6) ni el pooler en
# modo transacción (puerto 6543, no soporta prepared statements).
#   Host:    aws-0-<region>.pooler.supabase.com
#   Usuario: postgres.<project-ref>
#   Base:    postgres
# La app vive en el esquema `app` (lo crea Alembic) y n8n en el esquema `n8n`.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_SIZE=5

# n8n usa el mismo proyecto y pooler, en su propio esquema.
N8N_DB_HOST=aws-0-<region>.pooler.supabase.com
N8N_DB_PORT=5432
N8N_DB_DATABASE=postgres
N8N_DB_USER=postgres.<project-ref>
N8N_DB_PASSWORD=<password>
N8N_DB_POOL_SIZE=2
N8N_DB_SSL_ENABLED=true
# El certificado del pooler lo firma la CA de Supabase. Para validarlo, descargarla del
# dashboard, montarla en n8n y usar DB_POSTGRESDB_SSL_CA; mientras tanto, false.
N8N_DB_SSL_REJECT_UNAUTHORIZED=false

# --- Alternativa sin internet: perfil localdb --------------------------------
# docker compose --profile localdb up -d  y reemplazar lo de arriba por:
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres
#   DATABASE_URL_CONTAINER=postgresql+psycopg://postgres:postgres@postgres:5432/postgres
#   N8N_DB_HOST=postgres  N8N_DB_USER=postgres  N8N_DB_PASSWORD=postgres
#   N8N_DB_SSL_ENABLED=false  N8N_DB_SSL_REJECT_UNAUTHORIZED=true
#   (n8n activa SSL solo con que REJECT_UNAUTHORIZED sea false, y el Postgres local no tiene SSL)
# LOCALDB_PASSWORD=postgres
# LOCALDB_PORT=5432

# --- Lakehouse (Delta) -------------------------------------------------------
# Fuera de Docker: ruta relativa a la raíz del repo, o gs://<bucket>/lakehouse en GCP.
LAKEHOUSE_URI=./data/lakehouse
# Dentro del contenedor backend: /data/lakehouse (volumen local) o gs://<bucket>/lakehouse en GCP.
LAKEHOUSE_URI_CONTAINER=/data/lakehouse

# --- n8n ---------------------------------------------------------------------
# Generar una clave aleatoria larga (p. ej. `openssl rand -hex 32`) y no cambiarla después:
# cifra las credenciales guardadas en n8n.
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# En GCP detrás de HTTPS (Caddy) poner true.
N8N_SECURE_COOKIE=false

# --- Backend -----------------------------------------------------------------
BACKEND_PORT=8000
UVICORN_WORKERS=1

# --- Límites de memoria por servicio (meta lite < ~2.5 GB) -------------------
N8N_MEM_LIMIT=768m
BACKEND_MEM_LIMIT=512m
