      "parameters": {
        "jsCode": "const ctx = $('Contexto de la persona').first().json.body || {};\nconst msg = $('Mensaje de Telegram').first().json.message || {};\nconst item = $input.first();\nconst bin = item.binary.data;\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst allowed = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];\nconst mt = String(bin.mimeType || '').toLowerCase();\nconst mediaType = allowed.includes(mt) ? mt : 'image/jpeg';\nconst dates = (ctx.dates || []).map(d => (typeof d === 'string' ? d : (d.date || JSON.stringify(d)))).join(', ');\nconst products = (ctx.products || []).map(p => '- ' + p.id + ': ' + p.name + (p.category ? ' (' + p.category + (p.unit ? ', ' + p.unit : '') + ')' : '')).join('\\n');\nconst caption = msg.caption || '';\nconst contextText = [\n  'Hoy: ' + (ctx.today || ''),\n  'Fechas válidas: ' + (dates || '(ninguna)'),\n  'Puede proyectar: ' + (ctx.can_project ? 'sí' : 'no'),\n  'Puede registrar stock: ' + (ctx.can_stock ? 'sí' : 'no'),\n  'Productos (id: nombre):',\n  products || '(sin lista)',\n  caption ? 'Pie de foto: ' + caption : 'La foto no trae pie de foto.',\n  'Lee la foto y devuelve los datos en el formato pedido.'\n].join('\\n');\nreturn [{ json: { imageBase64: buf.toString('base64'), mediaType, contextText } }];\n"
      },
