            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Explicar qué enviar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cargar en el backend": {
      "main": [
        [
          {
            "node": "Responder con el resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Responder con el resultado": {
      "main": [
        [
          {
            "node": "¿Se cargó?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Se cargó?": {
      "main": [
        [
          {
            "node": "Avisar a los supervisores",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
