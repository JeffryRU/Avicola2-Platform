{
  "id": "avicola2WhatsappAris06",
  "name": "06_whatsapp_aris",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "messages"
        ]
      },
      "id": "d4a10006-0001-4c0e-9f00-000000000001",
      "name": "Mensaje de WhatsApp",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "d4a10006-0901-4c0e-9f00-000000000901",
      "notes": "Credencial: app de Meta (WhatsApp Business Cloud). Solo responde a los números de ARIS_WHATSAPP_NUMBERS."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d4a10006-0102-4c0e-9f00-000000000102",
              "leftValue": "={{ Array.isArray($json.messages) && $json.messages.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d4a10006-0002-4c0e-9f00-000000000002",
      "name": "¿Es un mensaje?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d4a10006-0103-4c0e-9f00-000000000103",
              "leftValue": "={{ ($env.ARIS_WHATSAPP_NUMBERS || '').split(',').map(s => s.replace(/\\D/g, '')).includes($json.messages[0].from) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d4a10006-0003-4c0e-9f00-000000000003",
      "name": "¿Número autorizado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        420,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d4a10006-0104-4c0e-9f00-000000000104",
              "leftValue": "={{ $json.messages[0].type }}",
              "rightValue": "document",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d4a10006-0004-4c0e-9f00-000000000004",
      "name": "¿Trae un documento?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        -100
      ]
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v21.0/{{ $json.messages[0].document.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "options": {}
      },
      "id": "d4a10006-0005-4c0e-9f00-000000000005",
      "name": "Pedir el enlace del archivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        -200
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "d4a10006-0006-4c0e-9f00-000000000006",
      "name": "Descargar el archivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        -200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/aris",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Token",
              "value": "={{ $env.INGEST_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "source",
              "value": "whatsapp"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          },
          "timeout": 600000
        }
      },
      "id": "d4a10006-0007-4c0e-9f00-000000000007",
      "name": "Cargar en el backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        -200
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $('Mensaje de WhatsApp').item.json.metadata.phone_number_id }}",
        "recipientPhoneNumber": "={{ $('Mensaje de WhatsApp').item.json.messages[0].from }}",
        "textBody": "={{ $json.statusCode === 200 ? '✅ Datos de ARIS cargados: ' + $json.body.map(l => l.rows + ' filas de ' + l.kind + ' (' + l.date_from + ' a ' + l.date_to + ')').join(' y ') + '. El modelo se reentrena en unos minutos.' : '❌ No se pudo cargar el archivo: ' + (($json.body && $json.body.detail) || ('error ' + $json.statusCode)) }}",
        "additionalFields": {}
      },
      "id": "d4a10006-0008-4c0e-9f00-000000000008",
      "name": "Responder con el resultado",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1520,
        -200
      ],
      "webhookId": "d4a10006-0908-4c0e-9f00-000000000908"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d4a10006-0109-4c0e-9f00-000000000109",
              "leftValue": "={{ $('Cargar en el backend').item.json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d4a10006-0009-4c0e-9f00-000000000009",
      "name": "¿Se cargó?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1740,
        -200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/notifications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Token",
              "value": "={{ $env.INGEST_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ audience: 'supervisors', title: 'Datos de ARIS cargados', body: ('Llegó por WhatsApp: ' + $('Cargar en el backend').item.json.body.map(l => l.rows + ' filas de ' + l.kind + ' (' + l.date_from + ' a ' + l.date_to + ')').join(' y ') + '. El modelo se reentrena en unos minutos.').slice(0, 500), link: '/modelo' }) }}",
        "options": {}
      },
      "id": "d4a10006-0010-4c0e-9f00-000000000010",
      "name": "Avisar a los supervisores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1960,
        -260
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $('Mensaje de WhatsApp').item.json.metadata.phone_number_id }}",
        "recipientPhoneNumber": "={{ $('Mensaje de WhatsApp').item.json.messages[0].from }}",
        "textBody": "Envíame el export de ARIS (DESPACHO y/o VENTAS) como documento: Excel (.xlsx) o CSV. Reemplazo solo las fechas que trae y el modelo se reentrena solo.",
        "additionalFields": {}
      },
      "id": "d4a10006-0011-4c0e-9f00-000000000011",
      "name": "Explicar qué enviar",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        860,
        0
      ],
      "webhookId": "d4a10006-0911-4c0e-9f00-000000000911"
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $('Mensaje de WhatsApp').item.json.metadata.phone_number_id }}",
        "recipientPhoneNumber": "={{ $('Mensaje de WhatsApp').item.json.messages[0].from }}",
        "textBody": "=Este número no está autorizado para cargar datos de ARIS. Pide a un supervisor que agregue {{ $json.messages[0].from }} a ARIS_WHATSAPP_NUMBERS.",
        "additionalFields": {}
      },
      "id": "d4a10006-0012-4c0e-9f00-000000000012",
      "name": "No autorizado",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        640,
        160
      ],
      "webhookId": "d4a10006-0912-4c0e-9f00-000000000912"
    }
