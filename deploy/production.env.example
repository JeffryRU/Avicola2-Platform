# Variables de producción (docs/deploy.md). Nunca se suben al repo.
#   - Dokploy / Coolify: pégalas en la pestaña Environment del proyecto.
#   - VPS sin panel o GCP: cópialas a /opt/avicola2/.env y usa --env-file.
# Genera cada secreto con:  openssl rand -hex 32

APP_ENV=production
TZ=America/Lima

# --- Dominios (HTTPS) --------------------------------------------------------
# Sin dominio propio: sslip.io apunta cualquier nombre a la IP que contiene.
# IP del VPS 203.0.113.10  →  app.203-0-113-10.sslip.io  y  n8n.203-0-113-10.sslip.io
APP_DOMAIN=app.203-0-113-10.sslip.io
N8N_DOMAIN=n8n.203-0-113-10.sslip.io

# --- Base de datos: Supabase (pooler en modo sesión, puerto 5432) -------------
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
N8N_DB_HOST=aws-0-<region>.pooler.supabase.com
N8N_DB_USER=postgres.<project-ref>
N8N_DB_PASSWORD=<password>

# --- Secretos (obligatorios: sin ellos la API no arranca) ---------------------
AUTH_SECRET=
INGEST_API_TOKEN=
# Cifra las credenciales guardadas en n8n: si cambia, n8n no puede leerlas.
N8N_ENCRYPTION_KEY=

# --- Opcionales (estos son los valores por defecto) ---------------------------
# LOG_FORMAT=text            # json si se envían a un colector de logs
# BACKUP_KEEP_DAYS=14        # días de respaldos de la base que se conservan
# BACKUP_EVERY_HOURS=24
# BACKEND_MEM_LIMIT=768m
# N8N_MEM_LIMIT=1g
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
